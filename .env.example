# MathPilot backend settings.
# Copy to .env and fill in (never commit .env):
#   NEBIUS_API_KEY=your_key_here
#   NEBIUS_MATH_MODEL=Qwen/Qwen3.5-397B-A17B
#   NEBIUS_SOCRATIC_MODEL=nvidia/Nemotron-3_5-Lightning
#   NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Without NEBIUS_API_KEY the app runs in labeled demo mode (mock tutor).
NEBIUS_API_KEY=
NEBIUS_MATH_MODEL=Qwen/Qwen3.5-397B-A17B
NEBIUS_SOCRATIC_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
DATABASE_URL=sqlite:///./mathpilot.db
DEMO_MODE=true
